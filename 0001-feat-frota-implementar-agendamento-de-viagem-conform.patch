+  }
+
+  return {
+    success: true,
+    tripId: '1042',
+    protocol: `VG-2026-${Math.floor(1000 + Math.random() * 9000)}`,
+    message: 'Viagem agendada e despachada com sucesso no Sistema Aratu.',
+  }
+}
