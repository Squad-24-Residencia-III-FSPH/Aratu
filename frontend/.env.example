# Copie para `frontend/.env` somente se precisar sobrescrever os padrões locais.
# O Vite lê variáveis do diretório do frontend, não do .env da raiz.

# Destino do proxy de desenvolvimento para /api (padrão: http://localhost:3000).
# No Docker Compose o frontend/Dockerfile já define http://backend:3000.
# API_PROXY_TARGET=http://localhost:3000

# URL base usada pelo cliente HTTP (padrão: /api, servido pelo proxy do Vite e pelo Nginx).
# Só defina se a API estiver em outra origem.
# VITE_API_BASE_URL=/api
