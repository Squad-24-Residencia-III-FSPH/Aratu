# Gere valores exclusivos para cada ambiente; use valores hexadecimais para a senha do banco.
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-random-hex
POSTGRES_DB=meubanco
POSTGRES_PORT=5432

# Para npm run dev no host; o container backend recebe a URL interna usando o host "db".
DATABASE_URL=postgresql://admin:replace-with-random-hex@localhost:5432/meubanco

# Ambiente da API: "development" mantém o Swagger UI em /docs; "production" o desabilita.
NODE_ENV=development
PORT=3000

# Banco isolado para os testes automatizados (npm test).
# DATABASE_URL_TEST tem prioridade; se omitida, o banco é derivado de DATABASE_URL
# usando POSTGRES_DB_TEST como nome.
POSTGRES_DB_TEST=aratu_test
DATABASE_URL_TEST=postgresql://admin:replace-with-random-hex@localhost:5432/aratu_test

# Gere um segredo exclusivo para cada ambiente; nao reutilize este placeholder.
JWT_SECRET=replace-with-a-random-secret-before-running
JWT_EXPIRES_IN=8h

# Credenciais do Administrador inicial provisionado pelo seed (npm run db:seed)
INITIAL_ADMIN_EMAIL=admin@aratu.fsph.se.gov.br
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_NAME=Administrador do Sistema

# Porta pública do frontend no Compose de produção (publicada apenas em 127.0.0.1).
# FRONTEND_PORT=8080

# Variáveis do frontend (Vite) ficam em frontend/.env; veja frontend/.env.example.
