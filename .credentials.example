# 1. Copie este arquivo para `.credentials` na raiz do repositório:
#    Copy-Item .credentials.example .credentials
# 2. Gere um API Token na sua conta Atlassian:
#    https://id.atlassian.com/manage-profile/security/api-tokens
# 3. Preencha seu e-mail e token abaixo (o arquivo `.credentials` é ignorado pelo Git):

JIRA_BASE_URL="https://squad24.atlassian.net"
JIRA_PROJECT_KEY="FROTA"
JIRA_EMAIL="seu-email@dominio.com"
JIRA_API_TOKEN="cole-seu-api-token-aqui"
